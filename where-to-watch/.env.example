# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development.
# On Vercel, add these under: Project -> Settings -> Environment Variables.
# Never commit the real `.env` file. It is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED --------------------------------------------------------------------
# TMDB API key (v3). Free. Get one at:
#   https://www.themoviedb.org/settings/api
# This powers search, details, and the "where to watch" provider data
# (TMDB sources provider data from JustWatch).
TMDB_API_KEY=

# OPTIONAL --------------------------------------------------------------------
# Your Amazon Associates tracking tag, e.g. mytag-20
# Used to build "find it on DVD/Blu-ray" links. Leave blank to hide those CTAs
# entirely (the app degrades gracefully and shows no affiliate buttons).
AMAZON_ASSOCIATE_TAG=

# Beehiiv email capture. Leave blank to hide the signup form.
# API key:        Beehiiv -> Settings -> Integrations -> API
# Publication ID: starts with "pub_"
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Default streaming region (ISO 3166-1 alpha-2). Defaults to US.
DEFAULT_REGION=US

# Set to 1 to serve built-in fixture data instead of calling TMDB.
# Useful for previewing the UI before you have an API key.
MOCK=0

# Local dev server port. Ignored on Vercel.
PORT=3000
